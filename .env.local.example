# Copy this file to .env.local and fill in the values from your Supabase
# project dashboard: Project Settings -> API.
#
# .env.local is already gitignored (see .gitignore's ".env*" rule) — never
# commit real keys.

# Project URL (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Anon / public key (Settings -> API -> Project API keys -> anon public)
# Safe to expose to the browser — Row Level Security policies are what
# actually protect the data behind this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Settings -> API -> Project API keys -> service_role)
# NEVER prefix this with NEXT_PUBLIC_. It bypasses Row Level Security and
# must only ever be read on the server (route handlers, server actions).
SUPABASE_SERVICE_ROLE_KEY=
